{
  "name": "flagstage-core",
  "private": true,
  "version": "0.1.0",
  "description": "Flagstage Core — self-hostable static sites, chat edits, and publish.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @flagstage/web dev",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run && node --import tsx --test packages/auth/src/*.node-test.ts",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @flagstage/db migrate",
    "db:seed": "pnpm --filter @flagstage/db seed",
    "docs:config": "tsx packages/config/scripts/generate-docs.ts",
    "flagstage": "tsx apps/cli/src/main.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.19.1",
    "esbuild": "0.25.12",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}

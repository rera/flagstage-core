# Flagstage Core environment.
# Copy to .env. Every variable is documented in docs/configuration.md,
# which is generated from packages/config.

# Required
DATABASE_URL=postgres://flagstage:flagstage@localhost:5432/flagstage
BETTER_AUTH_SECRET=replace-me-with-32-chars-minimum-secret
APP_URL=http://localhost:3000
PREVIEW_DOMAIN=localhost

# Storage. fs needs no extra services. s3 needs a bucket.
STORAGE_DRIVER=fs
FS_STORAGE_DIR=.data/storage
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=0

# Live hostname map and custom domains.
HOSTMAP_DRIVER=fs
DOMAINS_DRIVER=none
# CLOUDFRONT_KVS_ARN=
# CLOUDFRONT_DISTRIBUTION_ID=
# CLOUDFRONT_CONNECTION_GROUP_ID=
# CLOUDFRONT_CONNECTION_GROUP_ENDPOINT=

# Models. Set AI_API_KEY unless AI_PROVIDER is bedrock.
AI_PROVIDER=anthropic
# AI_API_KEY=
# AI_BASE_URL=
AI_MODEL_SMALL=claude-haiku-4-5
AGENT_MODEL=claude-sonnet-4-5
AGENT_TIMEOUT_SEC=600

# Mail is optional. Unset prints invites to the log.
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Flagstage Core <noreply@example.com>
# FORM_NOTIFY_EMAIL=leads@example.com

# First organization admin, used only when the database has no users.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
EMAIL_PASSWORD_ENABLED=1

# Import caps
IMPORT_MAX_PAGES=500
IMPORT_MAX_DEPTH=6
IMPORT_MAX_ASSETS=10000

ANALYTICS_ENABLED=1
LOG_LEVEL=info
# METRICS_TOKEN=
NODE_ENV=development
